{
  "name": "uhm-launcher-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx backend/dev/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "check": "npm run typecheck && npm test && npm run build",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "format": "prettier --write apps backend packages tests scripts/*.ts *.ts *.json supabase/functions",
    "format:check": "prettier --check apps backend packages tests scripts/*.ts *.ts *.json supabase/functions"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "jose": "^6.1.0",
    "lucide": "^0.468.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.19.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  }
}
